.idea

/lever
*.test

# acceptance gate runtime artifacts (broker keys/state, deposited bootstrap,
# tool sqlite db, runtime-written note) — never commit (contains secrets).
/ref.db
internal/cli/testdata/acceptance/.lever-state/
internal/cli/testdata/acceptance/workspace/.lever/
internal/cli/testdata/acceptance/docs/

# Local design drafts (not tracked)
drafts/
docs/audits/
docs/superpowers/plans/
docs/superpowers/specs/

# Per-instance runtime state + staged binaries from running the examples
# (broker keys/state, deposited bootstrap, scion project markers, cross-compiled
# in-jail binaries) — never commit.
**/.lever-state/
**/.lever/
**/.scion
**/.lever-manifest.yaml
examples/*/workspace/vendor/

# Machine-specific Makefile overrides (LEVER_INSTANCE etc.) — copy from local.mk.example
local.mk

# Generic agent-image build artifacts (staged by `make lever-image`).
image/lever-claude/bin/
image/lever-claude/scionhook/
image/scion-slim/bin/

# Stray local build outputs at repo root.
/lever-tool-todo
/lever-tool-github
/lever-tool-whisper
/lever-tool-tts
/lever-tool-db
examples/*/tools/*/lever-tool-*
!examples/*/tools/*/lever-tool-*/
/weather-stub
/dist/

# Agent tooling scratch: task briefs, review packages, generated diffs.
# Process artifacts, not project history — the findings that matter land in
# commit messages or the CHANGELOG.
.superpowers/
# Session notes and handovers are private, never committed (public repo).
/docs/*.md

# Prebuilt scion for the release (generated by genrelease in the release
# build): the assets it uploads, and the manifest lever embeds. Only the
# placeholder is tracked.
/build/
internal/provision/scionbin/release/*
!internal/provision/scionbin/release/.gitkeep

# The release workflow drops the prebuilt web UI here (see .goreleaser.yaml).
/_web-ui/
