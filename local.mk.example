# Machine-specific Makefile overrides. Copy this file to `local.mk` (gitignored)
# and set your own paths; it is included before the Makefile's `?=` defaults.

# The instance tree (config + prompt at the root; a `tree:` subdir is mounted
# into the manager container).
# LEVER_INSTANCE := $(HOME)/ai/my-instance

# Where the `lever-claude` image is built. Defaults to
# $(LEVER_INSTANCE)/image/lever-claude.
# LEVER_IMAGE_CTX := $(LEVER_INSTANCE)/image/lever-claude

# Where the host `lever` binary is installed (must be on PATH).
# PREFIX := $(HOME)/.local/bin
